# Required: choose an actual model ID supported by CrewAI and your provider.
# Format examples: openai/<model-id>, anthropic/<model-id>, gemini/<model-id>
# Fill the API key for the provider you select; leave other keys blank.
FACTORY_MODEL=

# Optional: a different model for the independent stage reviewer.
# Blank uses the specialist's model.
FACTORY_REVIEW_MODEL=

# Optional: specialist model overrides per stage. Blank uses FACTORY_MODEL.
# An explicit crewai.model in factory.json takes precedence over these settings.
FACTORY_MODEL_REQUIREMENTS=
FACTORY_MODEL_DESIGN=
FACTORY_MODEL_PLAN=
FACTORY_MODEL_IMPLEMENT=
FACTORY_MODEL_REVIEW=
FACTORY_MODEL_RETROSPECTIVE=

# Provider keys: only the selected provider's key is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Runtime privacy defaults. No cloud tracing is needed for local operation.
CREWAI_TRACING_ENABLED=false
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true
