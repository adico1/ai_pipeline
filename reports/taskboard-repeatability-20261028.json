      "review_false_positive": "AI reviewer claimed connections are closed, but storage returns raw sqlite3.Connection and domain uses its transaction-only context manager.",
      "source_evidence": {
        "domain.py": "import re\nfrom pathlib import Path\nfrom . import storage\n\nclass TaskboardError(Exception):\n    pass\n\ndef validate_title(title: str) -> str:\n    trimmed = title.strip()\n    if not trimmed:\n        raise TaskboardError(\"Task title cannot be blank.\")\n    return trimmed\n\ndef validate_id(id_str: str) -> int:\n    try:\n        id_int = int(id_str)\n    except Exception:\n        raise TaskboardError(\"Task ID must be an integer.\")\n    if id_int <= 0:\n        raise TaskboardError(\"Task ID must be a positive integer.\")\n    # SQLite signed 64-bit integer range\n    if not (-2**63 <= id_int < 2**63):\n        raise TaskboardError(\"Task ID out of range.\")\n    return id_int\n\ndef add_task(db_path: Path, title: str) -> dict:\n    trimmed = validate_title(title)\n    with storage.get_connection(db_path) as conn:\n        storage.init_schema(conn)\n        task = storage.add_task(conn, trimmed)\n        return task\n\ndef list_tasks(db_path: Path) -> list:\n    with storage.get_connection(db_path) as conn:\n        storage.init_schema(conn)\n        return storage.list_tasks(conn)\n\ndef complete_task(db_path: Path, id_str: str) -> dict:\n    id_int = validate_id(id_str)\n    with storage.get_connection(db_path) as conn:\n        storage.init_schema(conn)\n        task = storage.complete_task(conn, id_int)\n        if task is None:\n            raise TaskboardError(\"Task ID not found.\")\n        return task\n",
        "storage.py": "import sqlite3\nfrom contextlib import contextmanager\nfrom pathlib import Path\n\ndef get_connection(db_path: Path):\n    conn = sqlite3.connect(str(db_path))\n    conn.row_factory = sqlite3.Row\n    return conn\n\ndef init_schema(conn):\n    conn.execute(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS tasks (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            title TEXT NOT NULL,\n            completed INTEGER NOT NULL DEFAULT 0\n        )\n        \"\"\"\n    )\n    conn.commit()\n\ndef add_task(conn, title: str) -> dict:\n    cur = conn.execute(\n        \"INSERT INTO tasks (title, completed) VALUES (?, 0)\",\n        (title,)\n    )\n    conn.commit()\n    task_id = cur.lastrowid\n    return {\n        \"id\": task_id,\n        \"title\": title,\n        \"completed\": False\n    }\n\ndef list_tasks(conn) -> list:\n    cur = conn.execute(\n        \"SELECT id, title, completed FROM tasks ORDER BY id ASC\"\n    )\n    return [\n        {\n            \"id\": row[\"id\"],\n            \"title\": row[\"title\"],\n            \"completed\": bool(row[\"completed\"])\n        }\n        for row in cur.fetchall()\n    ]\n\ndef complete_task(conn, task_id: int) -> dict or None:\n    cur = conn.execute(\n        \"SELECT id, title, completed FROM tasks WHERE id = ?\",\n        (task_id,)\n    )\n    row = cur.fetchone()\n    if row is None:\n        return None\n    if not row[\"completed\"]:\n        conn.execute(\n            \"UPDATE tasks SET completed = 1 WHERE id = ?\",\n            (task_id,)\n        )\n        conn.commit()\n        completed = True\n    else:\n        completed = True\n    return {\n        \"id\": row[\"id\"],\n        \"title\": row[\"title\"],\n        \"completed\": completed\n    }\n"
